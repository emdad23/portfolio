# ─── Database ─────────────────────────────────────────────────────────────────
# Local (Docker): postgresql://portfolio:portfolio@localhost:5432/portfolio_dev
# Production (Supabase): postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio_dev"

# ─── Email ────────────────────────────────────────────────────────────────────
# The driver is chosen by env: SMTP when SMTP_HOST is set, Resend otherwise.
# Neither configured → the contact form still saves the submission, no mail.

# Addresses, shared by both drivers (RESEND_FROM_EMAIL / RESEND_TO_EMAIL still
# work as fallbacks). MAIL_TO overrides the contact email set in admin → Settings,
# so keep it for local dev but leave it unset in production.
MAIL_FROM="portfolio@localhost"
MAIL_TO="inbox@localhost"

# SMTP — local dev via Mailpit (docker-dev/docker-compose.yml), UI on :8025.
# Host-side `npm run dev`: localhost. Inside the dev container: mailpit (the
# compose service name, already injected there). Use host.docker.internal only
# to reach a Mailpit you run on the host instead of the bundled service — in
# that case skip the compose service or shift MAILPIT_SMTP_PORT/MAILPIT_UI_PORT.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""

# Resend (production) — get your key at https://resend.com, free tier is enough.
# Leave the placeholder to keep it disabled.
RESEND_API_KEY="re_your_key_here"
RESEND_FROM_EMAIL="portfolio@yourdomain.com"
RESEND_TO_EMAIL="your@email.com"

# ─── Admin ────────────────────────────────────────────────────────────────────
# Signs the admin session cookie. At least 32 random chars:
#   openssl rand -base64 32
AUTH_SECRET=""
# Secret URL segment the admin lives under: site.com/<ADMIN_PATH>/login.
# /admin itself always 404s. Leave empty to disable the admin entirely.
# Must be set at build time as well as runtime (middleware reads it).
ADMIN_PATH=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"