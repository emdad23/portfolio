# ─── Database ─────────────────────────────────────────────────────────────────
# Local (Docker): postgresql://portfolio:portfolio@localhost:5432/portfolio_dev
# Production (Supabase): postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio_dev"

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Get your key at https://resend.com — free tier is enough
RESEND_API_KEY="re_your_key_here"
RESEND_FROM_EMAIL="portfolio@yourdomain.com"
RESEND_TO_EMAIL="your@email.com"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"